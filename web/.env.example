# Copy to .env.local and fill in real values for LOCAL DEV ONLY.
# .env.local must always point at the dev/test Supabase project and a
# TEST-mode Stripe key -- never production, never a live key. Each Vercel
# scope (Preview, Production) holds its own separate values, edited only
# in the Vercel dashboard/CLI, never copy-pasted into this file.
#
# One variable, one value, no "alternate mode" blocks: a previous version
# of .env.local defined STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET twice
# each (test then live) -- dotenv resolves duplicate keys last-wins, so
# local dev was silently running against a live/test mismatch with no
# warning. Don't reintroduce that pattern.

NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server-only -- never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Stripe -- TEST MODE. Never put a live (sk_live_) key here.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
